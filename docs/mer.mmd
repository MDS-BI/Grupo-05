        decimal discount_pct
        varchar reason "obligatorio"
        varchar decision "pendiente, aprobado, rechazado"
        datetime requested_at
        datetime decided_at
    }
    returns_rma {
        int rma_id PK
        int sales_order_id FK
        int customer_id FK
        date rma_date
        varchar reason
        varchar status
    }
    rma_lines {
        int rma_line_id PK
        int rma_id FK
        int product_id FK
        int quantity "entero"
    }
    shipments {
        int shipment_id PK
        int sales_order_id FK
    }
    ar_invoices {
        int ar_invoice_id PK
        int sales_order_id FK
    }

