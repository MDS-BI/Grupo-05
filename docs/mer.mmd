    customers {
        int customer_id PK
        int address_id FK
        int assigned_employee_id FK
        varchar customer_code "nuevo"
        varchar customer_name
        varchar tax_id "RUT, nuevo"
        varchar email
        varchar phone
        varchar segment "nuevo"
        decimal credit_limit "nuevo"
        varchar payment_terms "nuevo"
        date next_contact_date "nuevo"
        text notes "nuevo"
        date customer_since
    }
    products {
        int product_id PK
        varchar sku
        varchar product_name
        decimal standard_cost
    }
    employees {
        int employee_id PK
        varchar first_name
        varchar last_name
    }
    opportunities {
        int opportunity_id PK
        int customer_id FK
        decimal estimated_value
    }
    addresses {
        int address_id PK
        varchar city
    }
    currencies {
        varchar currency_code PK
        varchar symbol
    }
    tax_codes {
        int tax_code_id PK
        varchar tax_name
        decimal tax_rate
    }
    price_lists {
        int price_list_id PK
        varchar currency_code FK
        varchar price_list_name
        date valid_from
        date valid_to
    }
    price_list_items {
        int price_list_item_id PK
        int price_list_id FK
        int product_id FK
        decimal unit_price
    }
    sales_quotes {
        int quote_id PK
        int customer_id FK
        int opportunity_id FK "opcional"
        int employee_id FK
        int price_list_id FK "nuevo"
        int lost_reason_id FK "nuevo, si perdida"
        varchar currency_code FK "nuevo"
        varchar series "nuevo, UNIQUE con folio"
        int folio "nuevo"
        date quote_date
        date expiry_date
        varchar payment_terms "nuevo"
        varchar status "cotización, enviada, aceptada, perdida, anulada"
        decimal subtotal "nuevo"
        decimal discount "nuevo"
        decimal tax_amount "nuevo"
        decimal total_amount "nuevo"
        text notes "nuevo"
    }
    sales_quote_lines {
        int quote_line_id PK
        int quote_id FK
        int product_id FK
        int quantity "entero"
        decimal unit_price
        decimal discount_pct "nuevo"
        decimal line_total "nuevo"
    }
    lost_reasons {
        int lost_reason_id PK
        varchar reason_name "precio, plazo, sin stock, competencia, otro"
    }
    sales_orders {
        int sales_order_id PK
        int customer_id FK
        int employee_id FK
        int opportunity_id FK "opcional"
        int quote_id FK "opcional"
        int price_list_id FK "nuevo"
        varchar currency_code FK "nuevo"
        varchar series "nuevo, UNIQUE con folio"
        int folio "nuevo"
        date order_date
        date delivery_date "nuevo"
        varchar payment_terms "nuevo"
        varchar status "confirmado, despachado, facturado, anulado"
        decimal subtotal "nuevo"
        decimal discount "nuevo"
        decimal tax_amount "nuevo"
        decimal total_amount
        text notes "nuevo"
    }
    sales_order_lines {
        int sales_order_line_id PK
        int sales_order_id FK
        int product_id FK
        int tax_code_id FK "nuevo"
        int quantity "entero"
        decimal unit_price
        decimal discount_pct "nuevo"
        decimal line_total "nuevo"
    }
    discount_approvals {
        int approval_id PK
        int quote_id FK
        int sales_order_id FK "al confirmarse"
        int requested_by FK "vendedor"
